# MinGW-w64 native Win32 build of zipopt; private UnZip core, no Unix objects.
# SPDX-License-Identifier: MIT-0
CC ?= gcc
CFLAGS ?= -O2 -std=gnu89 -Wall -Wextra
CPPFLAGS += -DWIN32 -DFORCE_WIN32_OVER_UNIX
LOCAL_UNZIP ?=
LOCAL_ZIP ?=
LOCAL_GLDFLAGS ?=
UZDIR = ../unzip60
WIN_DEFS = -DWIN32 -DFORCE_WIN32_OVER_UNIX -DDLL -DNO_ZLIB_NG -DNO_EXCEPT_SIGNALS
# Baseline uses internal codecs and never searches host pkg-config paths.
WIN_DEFS += -DZIPOPT_EMBED
WIN_ZIPOPT_DEFS = -DZO_NO_EXTERNAL_CODECS
UZUNITS = unzip crc32 crypt envargs explode extract fileio globals inflate list match process ttyio ubz2err unreduce unshrink zipinfo api
UZWINDOWS = win32 win32i64 nt
UZOBJS = $(addprefix winbuild/uz-,$(addsuffix .o,$(UZUNITS) $(UZWINDOWS)))
UZFLAGS = $(CFLAGS) $(WIN_DEFS) $(CPPFLAGS) $(LOCAL_UNZIP) -I$(UZDIR) -I$(UZDIR)/win32
LIBS = -luser32 -ladvapi32
winbuild:
	mkdir -p $@
winbuild/uz-%.o: $(UZDIR)/%.c | winbuild
	$(CC) $(UZFLAGS) -c $< -o $@
winbuild/uz-win32.o: $(UZDIR)/win32/win32.c | winbuild
	$(CC) $(UZFLAGS) -c $< -o $@
winbuild/uz-win32i64.o: $(UZDIR)/win32/win32i64.c | winbuild
	$(CC) $(UZFLAGS) -c $< -o $@
winbuild/uz-nt.o: $(UZDIR)/win32/nt.c | winbuild
	$(CC) $(UZFLAGS) -c $< -o $@
ZIPDEPS = $(wildcard ../zip30/deflate64.c ../zip30/deflate.c ../zip30/trees.c ../zip30/pkdcl.c ../zip30/ppmd8.c ../zip30/ppmd8enc.c ../zip30/zopfli.c ../zip30/d64opt.inc ../zip30/d64split.inc)
all: zipopt.exe zipopt-preflight.exe zipopt-decodecheck.exe crc-accel-test.exe
winbuild/zo-codec.o: codec.c codec.h $(ZIPDEPS) | winbuild
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LOCAL_ZIP) $(WIN_ZIPOPT_DEFS) -DZO_SHARED_UNZIP_CODECS -c $< -o $@
winbuild/zo-zip-deflate.o: zip_deflate.c zip_deflate.h ../zip30/zip.h | winbuild
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LOCAL_ZIP) -c $< -o $@
zipopt.exe: archive.c extract.c writer.c zipopt.c win32_port.h $(UZOBJS) winbuild/zo-codec.o winbuild/zo-zip-deflate.o
	$(CC) $(CPPFLAGS) $(CFLAGS) $(WIN_ZIPOPT_DEFS) archive.c extract.c writer.c zipopt.c winbuild/zo-codec.o winbuild/zo-zip-deflate.o $(UZOBJS) $(LIBS) -lm -o $@ $(LOCAL_GLDFLAGS)
zipopt-preflight.exe: archive.c preflight.c
	$(CC) $(CPPFLAGS) $(CFLAGS) archive.c preflight.c -o $@ $(LOCAL_GLDFLAGS)
zipopt-decodecheck.exe: archive.c extract.c decodecheck.c $(UZOBJS)
	$(CC) $(CPPFLAGS) $(CFLAGS) archive.c extract.c decodecheck.c $(UZOBJS) $(LIBS) -o $@ $(LOCAL_GLDFLAGS)
# CRC A/B test: hardware dispatch vs the identical built-in code with
# NO_PCLMUL_CRC explicitly selected, including short and split buffers.
winbuild/crc-software.o: $(UZDIR)/crc32.c | winbuild
	$(CC) $(UZFLAGS) -DNO_PCLMUL_CRC -Dcrc32=iz_crc32_software -Dget_crc_table=iz_get_crc_table_software -c $< -o $@
crc-accel-test.exe: tests/crc_accel_win.c winbuild/uz-crc32.o winbuild/crc-software.o
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/crc_accel_win.c winbuild/uz-crc32.o winbuild/crc-software.o -o $@ $(LOCAL_GLDFLAGS)
clean:
	rm -rf winbuild zipopt.exe zipopt-preflight.exe zipopt-decodecheck.exe crc-accel-test.exe
.PHONY: all clean
