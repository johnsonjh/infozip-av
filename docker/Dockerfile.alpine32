FROM i386/alpine:latest

USER 0

WORKDIR /

RUN set -x && cd && \
  apk update || true && \
  apk add git && \
  apk update || true && \
  apk add '!usr-merge-nag' 2> /dev/null || true && \
  apk upgrade --prune || true && \
  apk add curl gawk gcc gcompat gnu-libiconv gnu-libiconv-dev gnu-libiconv-libs libc-dev libintl libtool autoconf automake autoconf-archive make musl-libintl musl-utils pigz tar time sed coreutils bison flex linux-headers patch libc-dev gettext xz-dev xz-static zstd-dev zstd-static file file-dev upx cmake ccmake && \
  (cd /tmp && git clone https://github.com/zlib-ng/zlib-ng && cd zlib-ng && env CFLAGS="-O3 -flto=auto" ./configure --prefix=/usr --static && make -j $(nproc) && make install && cd .. && rm -rf ./zlib-ng) && \
  (cd /tmp && git clone --recursive git://sourceware.org/git/bzip2.git && cd bzip2 && make CFLAGS="-O3 -flto=auto -D_FILE_OFFSET_BITS=64" LDFLAGS="-O3 -flto=auto" -j $(nproc) libbz2.a && make install PREFIX=/usr && cd .. && rm -rf ./bzip2) && \
  (cd /tmp && git clone https://github.com/dbry/wavpack && cd wavpack && autoreconf -vfi && ./configure --disable-apps --disable-shared --enable-static --prefix=/usr && make -j $(nproc) && make install && cd .. && rm -rf ./wavpack) && \
  (cd /tmp && git clone https://github.com/tfenne/bz2-ng && cd bz2-ng/c && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS="-O3 -flto=auto" -DCMAKE_INSTALL_PREFIX=/usr && cd build && make -j $(nproc) && make install && cd ../../.. && rm -rf ./bz2-ng) && \
  (cd /tmp && git clone https://github.com/ebiggers/libdeflate && cd libdeflate && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS="-O3 -flto=auto" -DCMAKE_INSTALL_PREFIX=/usr -DLIBDEFLATE_BUILD_STATIC_LIB=ON -DLIBDEFLATE_BUILD_SHARED_LIB=OFF && cd build && make -j $(nproc) && make install && cd ../.. && rm -rf libdeflate) &&  \
  (cd /opt && curl -fsSL http://www.ibaug.de/vbcc/vbcc_linux_x64.tar.gz | pigz -dc | tar xf -)

RUN touch /.OK

RUN printf '\n%s\n' "BUILD SUCCESS"
