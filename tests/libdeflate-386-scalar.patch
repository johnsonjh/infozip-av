+/* DJGPP/80386 builds need scalar implementations throughout.  Selecting
+ * scalar functions at runtime is not enough: libdeflate otherwise still
+ * compiles SSE/AVX code, whose alignment is unsupported by DJGPP and whose
+ * instructions are unavailable on the 80386.  Windows builds do not set
+ * this flag and retain all accelerated paths. */
+#ifdef LIBDEFLATE_PORTABLE_X86
+#  undef ARCH_X86_32
+#  undef ARCH_X86_64
+#endif
+
